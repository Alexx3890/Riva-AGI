# ==============================================================================
# RAG Knowledge Subsystem - Environment Configuration Example
# ==============================================================================
# Copy this file to .env in your root directory or provide these in your environment.
# Note: If MISTRAL_API_KEY is omitted, the system seamlessly falls back to 
# returning structured factual knowledge directly without failing.

# Mistral AI API Key for RAG conversational answer synthesis (Required for LLM generation)
# Obtain your API key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral Chat Model ID (Optional, defaults to mistral-small-latest)
# Options: mistral-small-latest, mistral-large-latest, open-mistral-7b, ministral-8b-latest
MISTRAL_MODEL=mistral-small-latest

# MongoDB Database Connection (Required for RAG knowledge base)
# Obtain connection URI from MongoDB Atlas or local instance
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=riva_knowledge
MONGODB_COLLECTION=knowledge_documents

